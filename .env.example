FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=replace-with-at-least-32-random-characters
JWT_SECRET_KEY=replace-with-at-least-32-random-characters
MYSQL_DATABASE=nayami_order_system
MYSQL_ROOT_PASSWORD=replace-with-local-mysql-password
DATABASE_URL=mysql+pymysql://root:replace-with-url-encoded-password@127.0.0.1:3306/nayami_order_system?charset=utf8mb4
DOCKER_DATABASE_URL=mysql+pymysql://root:replace-with-url-encoded-password@mysql:3306/nayami_order_system?charset=utf8mb4
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/0
BACKEND_HOST=0.0.0.0
BACKEND_PORT=5000
FRONTEND_HOST=0.0.0.0
FRONTEND_PORT=5173
FRONTEND_ORIGIN=http://127.0.0.1:5173
PAYMENT_TIMEOUT_MINUTES=15
COUPON_MAX_RETRIES=3
COUPON_IDEMPOTENCY_TTL_SECONDS=900
COUPON_RESULT_TTL_SECONDS=7200
CART_TTL_SECONDS=2592000
COUPON_TASK_EAGER=false
DEFAULT_LANGUAGE=zh-CN
DEFAULT_CURRENCY=CNY
PAYMENT_MODE=simulated
DEMO_MODE=true
JWT_ACCESS_TOKEN_EXPIRES_SECONDS=1800
JWT_REFRESH_TOKEN_EXPIRES_SECONDS=604800
VITE_API_BASE_URL=/api
